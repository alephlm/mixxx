<?xml version="1.0" encoding="UTF-8"?>
<MixxxMIDIPreset mixxxVersion="2.3" schemaVersion="1">
    <info>
        <name>500 inpulse test</name>
        <author>Test</author>
        <description>Test controller for Lua integration</description>
    </info>
    <controller id="500 inpulse test">
        <controls>
            <!-- Play button with Lua handler for LED feedback -->
            <control>
                <group>[Channel2]</group>
                <key>playButtonHandler</key>
                <description>Play button with LED feedback (Lua)</description>
                <status>0x92</status>
                <midino>0x07</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>cue_default</key>
                <description>MIDI Learned from 2 messages.</description>
                <status>0x92</status>
                <midino>0x06</midino>
                <options>
                    <normal/>
                </options>
            </control>
            <!-- Test script binding -->
            <control>
                <group>[Channel2]</group>
                <key>testMidiFunction</key>
                <description>Test Lua script binding</description>
                <status>0x97</status>
                <midino>0x00</midino>
                <options>
                    <script-binding/>
                </options>
            </control>
        </controls>
    </controller>
</MixxxMIDIPreset>
